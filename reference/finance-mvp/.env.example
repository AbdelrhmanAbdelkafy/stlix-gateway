# Copy to .env and adjust. Docker Compose sets these for the api service.
ENVIRONMENT=development
API_PREFIX=/api/v1

# Local default is SQLite; the Compose stack uses MySQL:
# DATABASE_URL=mysql+pymysql://finance:finance@db:3306/finance_os
DATABASE_URL=sqlite:///./finance_mvp.db

# CHANGE THIS in any non-local environment (min 32 bytes).
JWT_SECRET=change-me-in-production-please-32-bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

REDIS_URL=redis://redis:6379/0

SEED_ADMIN_EMAIL=admin@finance.local
SEED_ADMIN_PASSWORD=Admin#12345
