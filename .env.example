# ---- Gateway ----
APP_ENV=dev
# Optional: require clients to send this as `X-API-Key`. Leave blank to disable.
GATEWAY_API_KEY=
# Extra accepted keys (comma-separated), on top of GATEWAY_API_KEY.
GATEWAY_API_KEYS=

# ---- Layer 6: logs / monitoring / security ----
LOG_LEVEL=INFO
LOG_JSON=true
# Requests per minute per client (0 disables the limiter).
RATE_LIMIT_PER_MINUTE=120
# Allowed CORS origins, comma-separated ("*" = any).
CORS_ORIGINS=*
SECURITY_HEADERS=true

# ---- Nama ERP REST v1 ----
# Cloud tenant:
NAMA_BASE_URL=https://stlixvalley.namasoft.net/erp/rest/v1
# Local dev (restored backup):
# NAMA_BASE_URL=http://localhost:8080/erp/rest/v1
NAMA_CLIENT_ID=
NAMA_CLIENT_SECRET=
NAMA_TIMEOUT=30
# Connector mode: read_only (safe default) | read_write
NAMA_MODE=read_only
# Banks connector reuses Nama creds; its own mode:
BANKS_MODE=read_only

# ---- Nama SQL (read-only) — balances from the restored backup ----
NAMA_SQL_SERVER=
NAMA_SQL_DATABASE=NAMA_TEST
NAMA_SQL_USER=
NAMA_SQL_PASSWORD=
NAMA_SQL_DRIVER=ODBC Driver 17 for SQL Server

# Which source answers /api/v1/finance/* when the caller does not pass ?source=.
#   sql  = the restored backup. Complete, and as old as the last restore.
#   live = rebuilt from Nama REST documents. Current, but only as of the last
#          sweep, and it carries the documents the credential cannot read.
# Do NOT set this to `live` until `scripts/reconcile_live_vs_sql.py` passes on
# this machine. Old is bad; wrong is far worse.
FINANCE_DEFAULT_SOURCE=sql

# Seconds between background live sweeps (0 = off). A sweep is ~14,000 documents
# and takes minutes, so without this the first page load after every restart
# waits for it. 3600 = one sweep an hour, starting at boot.
LIVE_FINANCE_REFRESH_SECONDS=0

# ---- drift guard ----
# After each sweep one CLOSED month is re-reconciled against SQL. A sweep can
# succeed and still come back short (a renamed Nama field, a narrowed
# credential) — freshness would look perfect. On `drift` the finance reads fall
# back to sql and say why. Being unable to check reports `unknown`, never `pass`.
FINANCE_GUARD_ENABLED=true
# Blank = a month far enough back that no new invoice will be issued into it.
# Pin (YYYYMM) only to investigate a specific window.
FINANCE_GUARD_PERIOD=
# Documents whose payment legitimately moved BACKWARDS — a voucher cancelled
# after the backup. No benign reading, so each is named by hand.
FINANCE_ALLOWED_REVERSALS=FP22026060000105

# ---- Inventory / Stocktake (count app) ----
INVENTORY_BASE_URL=
INVENTORY_KEY=
INVENTORY_MODE=read_only

# ---- CRM connector (Vtiger) ----
CRM_BACKEND=vtiger
CRM_MODE=read_only
VTIGER_URL=
VTIGER_USERNAME=
VTIGER_ACCESS_KEY=
CRM_TIMEOUT=30
