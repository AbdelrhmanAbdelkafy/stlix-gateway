# ---- Gateway ----
APP_ENV=dev
# Optional: require clients to send this as `X-API-Key`. Leave blank to disable.
GATEWAY_API_KEY=
# Extra accepted keys (comma-separated), on top of GATEWAY_API_KEY.
GATEWAY_API_KEYS=

# ---- Layer 6: logs / monitoring / security ----
LOG_LEVEL=INFO
LOG_JSON=true
# Requests per minute per client (0 disables the limiter).
RATE_LIMIT_PER_MINUTE=120
# Allowed CORS origins, comma-separated ("*" = any).
CORS_ORIGINS=*
SECURITY_HEADERS=true

# ---- Nama ERP REST v1 ----
# Cloud tenant:
NAMA_BASE_URL=https://stlixvalley.namasoft.net/erp/rest/v1
# Local dev (restored backup):
# NAMA_BASE_URL=http://localhost:8080/erp/rest/v1
NAMA_CLIENT_ID=
NAMA_CLIENT_SECRET=
NAMA_TIMEOUT=30
# Connector mode: read_only (safe default) | read_write
NAMA_MODE=read_only
# Banks connector reuses Nama creds; its own mode:
BANKS_MODE=read_only

# ---- CRM connector (Vtiger) ----
CRM_BACKEND=vtiger
CRM_MODE=read_only
VTIGER_URL=
VTIGER_USERNAME=
VTIGER_ACCESS_KEY=
CRM_TIMEOUT=30
